<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<suite name="Login Functionality">
    <test name="Login Test">
        <groups>
            <define name="smoke">
                <include name="smoke"/>
                <include name="valid"/>
            </define>

            <run>
                <include name="smoke"/>
                <exclude name="invalid"/>
            </run>
        </groups>

        <classes>
            <class name="XMLGroupOfGroups"/>
        </classes>
    </test>
</suite>
